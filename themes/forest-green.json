  "tokenColors": [
    {
      "name": "Premium Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.line.double-slash",
        "comment.block.documentation",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6B8E73",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Luxury Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp",
        "string.unquoted",
        "string.interpolated",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#50E3C2"
      }
    },
    {
      "name": "Premium String Escapes",
      "scope": [
        "constant.character.escape",
        "constant.character.escape.backslash"
      ],
      "settings": {
        "foreground": "#26C6DA",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Advanced Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.binary",
        "constant.numeric.octal",
        "constant.numeric.decimal"
      ],
      "settings": {
        "foreground": "#FFD700",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Premium Built-in Constants",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.nan",
        "constant.language.infinity"
      ],
      "settings": {
        "foreground": "#E91E63",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Luxury Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.return",
        "keyword.control.throw",
        "keyword.control.try",
        "keyword.control.catch",
        "keyword.control.finally",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#9013FE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Premium Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison",
        "keyword.operator.bitwise",
        "keyword.operator.increment",
        "keyword.operator.decrement",
        "keyword.operator.ternary",
        "punctuation.accessor",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#F5A623",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Advanced Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.constant",
        "variable.parameter",
        "variable.arguments",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#7ED321"
      }
    },
    {
      "name": "Premium Language Variables",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.super",
